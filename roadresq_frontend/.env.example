# Leave empty in development: requests go through the Vite proxy to DEV_BACKEND_URL.
VITE_API_URL=
VITE_SOCKET_URL=
# Set to 1 to log every socket event in a production build
VITE_SOCKET_DEBUG=0
# Backend used by the Vite dev proxy (default http://127.0.0.1:5050)
DEV_BACKEND_URL=http://127.0.0.1:5050
