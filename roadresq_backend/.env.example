MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
PORT=5050
# Comma-separated list of allowed frontend origins (REST + Socket.IO)
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Render, Heroku, nginx)
TRUST_PROXY=0
# Set to 1 to log every socket event
SOCKET_DEBUG=0
